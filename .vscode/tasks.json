{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "cppbuild",
      "command": "C:\\mingw64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "${workspaceFolder}\\main.cpp",
        "-o",
        "${workspaceFolder}\\main.exe",
        "-IC:\\mingw64\\include",
        "-LC:\\mingw64\\lib",
        "-lopengl32",
        "-lglew32",
        "-lglfw3",
        "-lglu32",
        "-lassimp",
        "-lz",
        "-lgdi32"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\mingw64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila o modelo 3D da Aula 10 com Display List, OpenGL e Assimp."
    }
  ]
}
